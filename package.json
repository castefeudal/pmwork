{
  "name": "pmwork",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-dev.mjs",
    "build": "next build && node scripts/prepare-pwa.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:validate": "node scripts/content-check.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "links:check": "node scripts/links-check.mjs",
    "export:validate": "node scripts/export-check.mjs",
    "verify": "npm run lint && npm run typecheck && npm run content:validate && npm run i18n:check && npm run links:check && npm run test && npm run build && npm run export:validate"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "date-fns": "4.1.0",
    "fuse.js": "7.1.0",
    "lucide-react": "0.542.0",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.1.5",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.34.0",
    "eslint-config-next": "16.2.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
